{
  "name": "medibridge-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "services/gateway",
    "packages/shared-types",
    "packages/design-tokens"
  ],
  "scripts": {
    "test:web": "npm run test --workspace=apps/web",
    "test:gateway": "npm run test --workspace=services/gateway",
    "test:js": "npm run test:web && npm run test:gateway",
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev-up.ps1",
    "dev:real": "powershell -ExecutionPolicy Bypass -File scripts/dev-up.ps1 -Real",
    "dev:stop": "powershell -ExecutionPolicy Bypass -File scripts/dev-down.ps1"
  }
}
