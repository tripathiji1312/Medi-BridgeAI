# Shared template for all Python FastAPI services (speech-pipeline, clinical-nlp,
# vision-service, orchestrator). Build context must be the repo root.
# Build with: docker build -f infra/docker/Dockerfile.python-service --build-arg SERVICE_DIR=services/speech-pipeline --build-arg SERVICE_PORT=8001 .
ARG SERVICE_DIR

FROM python:3.11-slim AS base
WORKDIR /app
ARG SERVICE_DIR
COPY ${SERVICE_DIR}/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY ${SERVICE_DIR}/app ./app
ARG SERVICE_PORT=8000
ENV SERVICE_PORT=${SERVICE_PORT}
EXPOSE ${SERVICE_PORT}
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${SERVICE_PORT}"]
