# Copy to .env and fill in for local dev. Never commit a real .env.
# Keep this file in sync with every new config value added to any service.

NODE_ENV=development

# --- Gateway ---
GATEWAY_PORT=4000
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=15m
SPEECH_PIPELINE_WS_URL=ws://localhost:8001/ws/transcribe

# --- Data layer (local dev via docker-compose.dev.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medibridge
POSTGRES_USER=medibridge
POSTGRES_PASSWORD=dev-only-change-me

REDIS_HOST=localhost
REDIS_PORT=6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dev-only-change-me
S3_SECRET_KEY=dev-only-change-me
S3_BUCKET=medibridge-media

# --- Python services ---
SPEECH_PIPELINE_PORT=8001
CLINICAL_NLP_PORT=8002
VISION_SERVICE_PORT=8003
ORCHESTRATOR_PORT=8004

# --- Third-party model providers (leave blank in Phase 0 — no live calls yet) ---
# Any provider added here MUST also be documented in docs/COMPLIANCE.md Section 5.
ANTHROPIC_API_KEY=
