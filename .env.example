# Copy to .env and fill in for local dev. Never commit a real .env.
# Keep this file in sync with every new config value added to any service.

NODE_ENV=development

# --- Gateway ---
GATEWAY_PORT=4000
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=15m
SPEECH_PIPELINE_WS_URL=ws://localhost:8001/ws/transcribe
# gateway proxies the clinician-facing conversation-memory reads/removes
# (Blueprint Section 2.4) to orchestrator.
ORCHESTRATOR_URL=http://localhost:8004

# --- Data layer (local dev via docker-compose.dev.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medibridge
POSTGRES_USER=medibridge
POSTGRES_PASSWORD=dev-only-change-me

REDIS_HOST=localhost
REDIS_PORT=6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dev-only-change-me
S3_SECRET_KEY=dev-only-change-me
S3_BUCKET=medibridge-media

# --- Python services ---
SPEECH_PIPELINE_PORT=8001
CLINICAL_NLP_PORT=8002
VISION_SERVICE_PORT=8003
ORCHESTRATOR_PORT=8004

# --- speech-pipeline model selection (local/self-hosted, no third-party retention) ---
ASR_MODEL_SIZE=small
MT_MODEL_NAME=facebook/nllb-200-distilled-600M
TTS_MODEL_NAME=facebook/mms-tts-eng
DIARIZATION_MODEL_SOURCE=speechbrain/spkrec-ecapa-voxceleb
# speech-pipeline calls clinical-nlp's /miscommunication/check endpoint as
# part of its per-utterance enrichment pipeline (Blueprint Section 3.2 step 6).
CLINICAL_NLP_URL=http://localhost:8002
# speech-pipeline also posts each finalized utterance to orchestrator's
# conversation-memory API (same var/value as gateway's ORCHESTRATOR_URL above).
ORCHESTRATOR_URL=http://localhost:8004
# Set to "1" to make speech-pipeline AND clinical-nlp serve deterministic
# canned responses (Static*Provider classes) instead of the real models --
# used by apps/web/e2e's Playwright suite and available for local dev
# without downloading any models. Never set in prod.
MEDIBRIDGE_FIXTURE_MODE=

# --- clinical-nlp model selection ---
SIMILARITY_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Third-party model providers (leave blank in Phase 0 — no live calls yet) ---
# Any provider added here MUST also be documented in docs/COMPLIANCE.md Section 5.
ANTHROPIC_API_KEY=
